{
  "expo": {
    "name": "Warung Digital",
    "slug": "warung-digital-uas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#EC4899"
    },
    "android": {
      "package": "com.namakamu.warungdigital",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#EC4899"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Aplikasi butuh akses kamera untuk memotret produk.",
          "photosPermission": "Aplikasi butuh akses galeri untuk memilih foto produk."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ab889c9c-7eee-472a-b4c8-847363427849"
      }
    }
  }
}
